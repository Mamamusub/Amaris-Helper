# Server-only Supabase configuration. Never use a service-role key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_PROJECT_KEY
APP_ORIGIN=http://localhost:3000

# Separate, optional Google Calendar OAuth client (not Google Login).
# Google Login provider credentials are configured in Supabase Auth, not here.
GOOGLE_CLIENT_ID=YOUR_CALENDAR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CALENDAR_CLIENT_SECRET
INTEGRATION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Server-only AI configuration for agent chat and live pipeline.
AI_PROVIDER=openai
# AI_API_KEY takes precedence; OPENAI_API_KEY is a legacy fallback.
AI_API_KEY=YOUR_SERVER_API_KEY
