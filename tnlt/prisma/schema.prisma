generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "sqlite"
}
model Record {
 id String @id @default(cuid())
 kind String
 code String @unique
 name String
 status String
 data Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 linksFrom Link[] @relation("source")
 linksTo Link[] @relation("target")
 movements Movement[]
 @@index([kind])
}
model Link {
 id String @id @default(cuid())
 sourceId String
 targetId String
 role String
 source Record @relation("source", fields:[sourceId], references:[id], onDelete:Restrict)
 target Record @relation("target", fields:[targetId], references:[id], onDelete:Restrict)
 @@unique([sourceId, role])
}
model Movement {
 id String @id @default(cuid())
 materialId String
 material Record @relation(fields:[materialId],references:[id],onDelete:Restrict)
 location String
 quantity Int
 cost Int
 projectId String?
 batch String
 createdAt DateTime @default(now())
 @@index([materialId,location])
}
model Audit {
 id String @id @default(cuid())
 requestId String @unique
 action String
 recordId String
 before Json?
 after Json
 createdAt DateTime @default(now())
}
